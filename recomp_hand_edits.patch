--- a/trace_logger.cpp
+++ b/trace_logger.cpp
@@ -0,0 +1,39 @@
+#include "trace_logger.h"
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+
+static constexpr size_t TRACE_BUFFER_SIZE = 1024;
+static constexpr size_t TRACE_MSG_LEN = 128;
+
+static char g_trace_buffer[TRACE_BUFFER_SIZE][TRACE_MSG_LEN];
+static size_t g_trace_index = 0;
+static size_t g_trace_count = 0;
+static std::mutex g_trace_mutex;
+
+extern "C" void push_trace(const char* msg) {
+    if (!msg) return;
+    std::lock_guard<std::mutex> lock(g_trace_mutex);
+    std::strncpy(g_trace_buffer[g_trace_index], msg, TRACE_MSG_LEN - 1);
+    g_trace_buffer[g_trace_index][TRACE_MSG_LEN - 1] = '\0';
+    g_trace_index = (g_trace_index + 1) % TRACE_BUFFER_SIZE;
+    if (g_trace_count < TRACE_BUFFER_SIZE) {
+        g_trace_count++;
+    }
+}
+
+extern "C" void dump_trace() {
+    std::lock_guard<std::mutex> lock(g_trace_mutex);
+    std::printf("\n============================================================\n");
+    std::printf("     FLIGHT RECORDER RING BUFFER DUMP (%zu events)\n", g_trace_count);
+    std::printf("============================================================\n");
+    size_t start = (g_trace_count < TRACE_BUFFER_SIZE) ? 0 : g_trace_index;
+    for (size_t i = 0; i < g_trace_count; i++) {
+        size_t idx = (start + i) % TRACE_BUFFER_SIZE;
+        std::printf("[%04zu] %s\n", i + 1, g_trace_buffer[idx]);
+    }
+    std::printf("============================================================\n");
+    std::printf("     END FLIGHT RECORDER TRACE DUMP\n");
+    std::printf("============================================================\n\n");
+    std::fflush(stdout);
+}
